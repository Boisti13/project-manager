{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Manager",
  "version": "0.2.0",
  "identifier": "com.boisti13.projectmanager",
  "build": {
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Manager",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Boisti13",
    "shortDescription": "Project Manager — works offline, syncs with your server",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCOTM3NzQyMjdGNkRENEIKUldSTDNmWW5RbmVUbXhmeTZvalNlTlBnS2ZDREdmdzdIdVNaWm8xSFIybnZxdXRuV1dZa1dhYnMK",
      "endpoints": [
        "https://github.com/Boisti13/project-manager/releases/download/desktop-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
